# Razorpay test credentials from Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
# Set this separately when creating the /webhook endpoint in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret

# Amounts are in paise and must be set server-side. 19900 = INR 199.00.
RAZORPAY_ITEM_PRICES={"1":19900,"2":9900}

# Public gateway URL used after a successful payment.
GATEWAY_HTTP_ADDRESS=http://localhost:8080